# Basic settings
ZSH_DISABLE_COMPFIX=true
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="mh"
DISABLE_UNTRACKED_FILES_DIRTY="true"
export AZURE_DEV_COLLECT_TELEMETRY=no
export PODMAN_IGNORE_CGROUPSV1_WARNING=1

# Path configuration
export PATH=$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH

# Oh My Zsh configuration
plugins=(git)

# Completions
fpath=(/usr/local/share/zsh-completions $fpath)

# Oh My Zsh
source $ZSH/oh-my-zsh.sh

# Aliases: lsd
if command -v lsd &> /dev/null; then
  alias ll='lsd -lh'
  alias ls='lsd'
  alias tree='ls --tree'
fi

# Aliases: bat
if command -v bat &> /dev/null; then
  alias cat='bat'
  alias ccat='bat --style=-grid,-numbers --paging=never'
fi

# Aliases: git
alias gl='git log --graph --pretty=format:"%C(white)%s%Creset" --abbrev-commit'
alias gll='git log --graph --decorate --pretty=oneline --abbrev-commit'
alias gs='git status --renames'

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then
  source "$HOME/google-cloud-sdk/path.zsh.inc"
fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then
  source "$HOME/google-cloud-sdk/completion.zsh.inc"
fi

# Direnv configuration
if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)"
fi

# Starship configuration
if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

# Go-task configuration
if command -v task &> /dev/null; then
    eval "$(task --completion zsh)"
fi

# Oh-My-Taskfiles configuration
if ! command -v omt &> /dev/null; then
  if [ ! -x omt ] && [ ! -x $HOME/bin/omt ]; then
    if [ -f "$HOME/.omt/taskfile.yaml" ]; then
      alias omt='task -t $HOME/.omt/taskfile.yaml'
    fi
  fi
fi

# Go configuration
if [ -x "/usr/local/go/bin" ]; then
  export PATH=$PATH:/usr/local/go/bin
fi

# Rust configuration
if [ -x "$HOME/.cargo/bin/rustc" ]; then
  source "$HOME/.cargo/env"
fi

# Awesome-git configuration
if command -v awesome-git &> /dev/null; then
  alias ag='awesome-git'
fi

# Podman socket configuration
if [ -S "$XDG_RUNTIME_DIR/podman/podman.sock" ]; then
  export DOCKER_HOST="unix://$XDG_RUNTIME_DIR/podman/podman.sock"
fi

# Kubectl configuration
if [ command -v kubectl >/dev/null 2>&1 ]; then
  alias k=kubectl
fi

# Python virtual environments configuration
if [ command -v pyenv >/dev/null 2>&1 ]; then
  export PATH="$HOME/.pyenv/bin:$PATH"
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"
fi

# Load environment variables safely from ~/.env, if it exists
if [ -f "$HOME/.env" ]; then
  export $(cat "$HOME/.env" | xargs)
fi

# opencode configuration
if [ -x "$HOME/.opencode/bin/opencode" ]; then
  export PATH=$HOME/.opencode/bin:$PATH
fi

# fnm configuration
if [ command -v fnm >/dev/null 2>&1 ]; then
  eval "$(fnm env --use-on-cd --version-file-strategy=recursive --shell zsh)"
fi

# bun configuration
if [ -x "$HOME/.bun/bin/bun" ]; then
  [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
  export BUN_INSTALL="$HOME/.bun"
  export PATH="$BUN_INSTALL/bin:$PATH"
fi

# zed configuration
if [ -f "/mnt/c/WINDOWS/System32/cmd.exe" -a -z "$WSL_HOME" ]; then
  WSL_USER=$(cd /mnt/c/WINDOWS/System32 && /mnt/c/WINDOWS/System32/cmd.exe /c "echo %USERNAME%" | tr -d '\r')
  WSL_HOME="/mnt/c/Users/${WSL_USER}"
  export WSL_USERNAME="${WSL_USER}"
  export WSL_USER="${WSL_USER}"
  export WSL_HOME="${WSL_HOME}"
  if [ -f "${WSL_HOME}/scoop/apps/zed/current/bin/zed" ]; then
    alias zed="${WSL_HOME}/scoop/apps/zed/current/bin/zed"
  fi
fi

# browser configuration
if [ -z "$BROWSER" -a ! -h "$BROWSER" ]; then
  if [ ! -h "${HOME}/.local/bin/wsl-browser" ]; then
    mkdir -p ${HOME}/.local/bin
    if [ -f '/mnt/c/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe' ]; then
      ln -s '/mnt/c/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe' ~/.local/bin/wsl-browser
    elif [ -n "$WSL_USER" -a -n "$WSL_HOME" -a -d "$WSL_HOME" -a -f "${WSL_HOME}/scoop/apps/brave/current/brave.exe" ]; then
      ln -s "${WSL_HOME}/scoop/apps/brave/current/brave.exe" ~/.local/bin/wsl-browser
    fi
  fi
  if [ -h "${HOME}/.local/bin/wsl-browser" ]; then
    export BROWSER="${HOME}/.local/bin/wsl-browser"
  fi
fi

# wsl2-ssh-agent configuration
if [ -x "$HOME/bin/wsl2-ssh-agent" ]; then
  eval $($HOME/bin/wsl2-ssh-agent)
fi
